<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <columns name="customer_columns">
        <column name="terms_accepted" component="Magento_Ui/js/grid/columns/select" sortOrder="200">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Accepted Terms of Use</label>
            </settings>
        </column>
        <column name="terms_accepted_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="210">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Terms Accepted At</label>
            </settings>
        </column>
    </columns>
</listing>
