# Copie para .env apenas se quiser sobrescrever os padrões.
# Após mudar portas/host, rode "docker compose up -d" novamente.

HTTP_PORT=8080
MAGENTO_HOST=localhost
DB_PORT=3307

MAGENTO_VERSION=2.4.8-p5
MAGENTO_ADMIN_FRONTNAME=admin
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin@12345
MAGENTO_ADMIN_EMAIL=admin@example.com

MAGENTO_CUSTOMER_EMAIL=cliente@example.com
MAGENTO_CUSTOMER_PASSWORD=Cliente@12345

MAGENTO_LOCALE=pt_BR
MAGENTO_CURRENCY=BRL
MAGENTO_TIMEZONE=America/Sao_Paulo

DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
DB_ROOT_PASSWORD=root
